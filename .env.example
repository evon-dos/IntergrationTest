# CreateHost API Configuration
# Copy this file to .env and update with your actual values

# Full API URL (Option 1: Direct URL)
CREATE_HOST_API_URL=https://api.example.com/v1/hosts/create

# Or use separate base URL and endpoint (Option 2: Separate components)
API_BASE_URL=https://api.example.com
CREATE_HOST_ENDPOINT=/v1/hosts/create

# Environment Selection
ENVIRONMENT=development

# API Authentication (if required)
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here

# Additional Configuration
API_TIMEOUT=30000
API_RETRY_ATTEMPTS=3
