{
  "api": {
    "baseUrl": "https://api.example.com",
    "endpoints": {
      "createHost": "/v1/hosts/create",
      "getHost": "/v1/hosts/{id}",
      "updateHost": "/v1/hosts/{id}",
      "deleteHost": "/v1/hosts/{id}",
      "listHosts": "/v1/hosts"
